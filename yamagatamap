<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>山形 絶景・名湯・サウナ旅 インタラクティブガイドマップ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Leaflet.js (Map) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700;900&family=Kiwi+Maru:wght@500&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Zen Maru Gothic', sans-serif;
        }
        .font-hand {
            font-family: 'Kiwi Maru', serif;
        }
        #map {
            height: calc(100vh - 70px);
            width: 100%;
            z-index: 10;
        }
        @media (max-width: 768px) {
            #map {
                height: 55vh;
            }
        }
        /* カスタムマップマーカー */
        .custom-pin {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            color: white;
            font-size: 16px;
            border: 3px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: transform 0.2s ease;
        }
        .custom-pin:hover {
            transform: scale(1.15);
        }
        .pin-day1 { background-color: #0284c7; } /* Sky 600 */
        .pin-day2 { background-color: #059669; } /* Emerald 600 */
        .pin-hub  { background-color: #9333ea; } /* Purple 600 */
        .pin-food { background-color: #e11d48; } /* Rose 600 */

        /* Leaflet Popup カスタマイズ */
        .leaflet-popup-content-wrapper {
            border-radius: 16px;
            padding: 4px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
            font-family: 'Zen Maru Gothic', sans-serif;
        }
        .leaflet-popup-content {
            margin: 10px 14px;
            line-height: 1.5;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex flex-col min-h-screen">

    <!-- トップヘッダー -->
    <header class="bg-slate-900 text-white px-4 py-3 shadow-md z-30 flex justify-between items-center shrink-0">
        <div class="flex items-center gap-2">
            <span class="text-2xl">🗺️</span>
            <div>
                <h1 class="text-base sm:text-lg font-bold font-hand leading-tight">山形 絶景・名湯・サウナ旅 地図ガイド</h1>
                <p class="text-[11px] text-slate-300 hidden sm:block">2026.08.19 - 08.20 ｜ Galaxy S24 Ultraフォト旅 ｜ 20時C/O特権活用</p>
            </div>
        </div>
        
        <!-- 表示フィルター切替 -->
        <div class="flex gap-1.5 text-xs font-bold">
            <button onclick="filterRoute('all')" id="btn-all" class="px-2.5 py-1.5 rounded-lg bg-sky-500 text-white shadow">全表示</button>
            <button onclick="filterRoute('day1')" id="btn-day1" class="px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700">1日目 (山寺)</button>
            <button onclick="filterRoute('day2')" id="btn-day2" class="px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700">2日目 (蔵王)</button>
        </div>
    </header>

    <!-- メインコンテンツ（マップ＋サイドパネル） -->
    <div class="flex-1 flex flex-col md:flex-row relative overflow-hidden">
        
        <!-- サイドバー / スポット・タイムライン一覧 -->
        <aside class="w-full md:w-96 bg-white border-r border-slate-200 flex flex-col h-auto md:h-[calc(100vh-70px)] order-2 md:order-1 z-20 shadow-lg">
            
            <!-- サマリーカード -->
            <div class="p-3 bg-gradient-to-r from-purple-900 to-indigo-900 text-white text-xs space-y-1">
                <div class="flex justify-between items-center font-bold">
                    <span>🏨 基地：スーパーホテル山形駅西口</span>
                    <span class="bg-purple-500 text-white text-[10px] px-1.5 py-0.5 rounded">20時C/O</span>
                </div>
                <p class="text-purple-200 text-[11px]">最終日は16:50まで部屋を活用！直前シャワー＆快適パッキングで空港へ</p>
            </div>

            <!-- スポットリスト -->
            <div class="flex-1 overflow-y-auto p-3 space-y-3 text-xs" id="spot-list">
                <!-- JSで動的生成 -->
            </div>
        </aside>

        <!-- マップ表示エリア -->
        <main class="flex-1 relative order-1 md:order-2">
            <div id="map"></div>
            
            <!-- 地図上のオーバーレイ凡例 -->
            <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-md p-3 rounded-xl shadow-lg z-[500] text-xs space-y-1.5 border border-slate-200">
                <div class="font-bold text-slate-800 border-b border-slate-200 pb-1 mb-1">ルート凡例</div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-sky-600 inline-block"></span>
                    <span>1日目：山寺＆市街地サウナ</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block"></span>
                    <span>2日目：蔵王高原＆市街地散策</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-purple-600 inline-block"></span>
                    <span>拠点：山形駅前（ホテル）</span>
                </div>
            </div>
        </main>
    </div>

    <!-- Leaflet Script & Map Logic -->
    <script>
        // スポットデータ（緯度・経度・詳細情報）
        const spots = [
            {
                id: 'airport',
                title: '山形空港（おいしい山形空港）',
                category: 'hub',
                day: [1, 2],
                lat: 38.4119,
                lng: 140.3712,
                icon: 'fa-plane',
                time: '1日目 08:15着 / 2日目 19:10発',
                desc: '山形駅前まで空港シャトルバスで約35分（980円）。帰りは17:00発バスで17:35空港着。',
                photo: '空港売店で最後のお土産調達やカフェ休憩に最適！'
            },
            {
                id: 'hotel',
                title: 'スーパーホテル山形駅西口天然温泉',
                category: 'hub',
                day: [1, 2],
                lat: 38.2480,
                lng: 140.3275,
                icon: 'fa-hotel',
                time: '旅のメインベースキャンプ',
                desc: '★全館禁煙＆天然温泉！【20時チェックアウト特権】適用。最終日は16:50まで部屋を使えるため、直前シャワー＆パッキングが可能！',
                photo: 'Galaxy S24 Ultraや冷却ベストのバッテリー充電基地にも活用。'
            },
            {
                id: 'yamadera',
                title: '宝珠山 立石寺（山寺）',
                category: 'day1',
                day: [1],
                lat: 38.3120,
                lng: 140.4367,
                icon: 'fa-mountain',
                time: '1日目 10:20 - 13:00',
                desc: '1,000段の石段を登る絶景寺院。空調服＆水冷ベストをフル装備して酷暑突破！',
                photo: '📱五大堂から見下ろす崖と集落の大パノラマをGalaxy S24 Ultraの200MP超広角で撮影！'
            },
            {
                id: 'fujita',
                title: '麺藤田（めんどうだ）',
                category: 'food',
                day: [1],
                lat: 38.2492,
                lng: 140.3298,
                icon: 'fa-utensils',
                time: '1日目 昼食候補',
                desc: '鶏・豚・魚介をあわせた濃厚トリプルスープのつけ麺店。モチモチ自家製太麺が絶品。',
                photo: '山寺登山で消費したカロリーと塩分を最高の形で補給！'
            },
            {
                id: 'sakaeya',
                title: '栄屋本店（冷やしラーメン）',
                category: 'food',
                day: [1],
                lat: 38.2541,
                lng: 140.3394,
                icon: 'fa-bowl-food',
                time: '1日目 昼食候補',
                desc: '山形名物「冷やしラーメン」発祥の老舗。スープに氷が浮かび、暑い夏の体に染み渡る！',
                photo: '元祖冷やしラーメンの見た目も清涼感抜群。'
            },
            {
                id: 'terme',
                title: 'スーパー銭湯テルメ',
                category: 'day1',
                day: [1],
                lat: 38.2325,
                lng: 140.3150,
                icon: 'fa-hot-tub-person',
                time: '1日目 16:30 - 18:30',
                desc: '市街地の広々温浴施設。サウナ専用メガネを装着し、山寺登山の疲労をじっくり解放＆整い体験！',
                photo: '温冷交互浴で翌日への体力リセット。'
            },
            {
                id: 'zao_ropeway',
                title: '蔵王ロープウェイ 地蔵山頂駅',
                category: 'day2',
                day: [2],
                lat: 38.1331,
                lng: 140.4439,
                icon: 'fa-cable-car',
                time: '2日目 09:30 - 11:30',
                desc: '標高1,661mの爽やかな高山エリア。下界の猛暑を忘れる涼しい爽風が吹く。',
                photo: '📱ダイナミックな山々の斜面と高山植物をGalaxy S24 Ultraの望遠レンズで鮮明キャプチャ！'
            },
            {
                id: 'zao_onsen',
                title: '蔵王温泉 大露天風呂',
                category: 'day2',
                day: [2],
                lat: 38.1632,
                lng: 140.4030,
                icon: 'fa-water',
                time: '2日目 11:30 - 12:30',
                desc: '渓流と森林に囲まれた巨大な露天風呂。源泉掛け流しの強力な強酸性硫黄泉を満喫！',
                photo: '大自然の緑とミルキーブルーの湯のコントラストが美しい名湯。'
            },
            {
                id: 'kajo_park',
                title: '霞城公園（山形城跡）',
                category: 'day2',
                day: [2],
                lat: 38.2530,
                lng: 140.3278,
                icon: 'fa-bicycle',
                time: '2日目 14:30 - 15:30',
                desc: 'HELLO CYCLINGのシェアサイクルでポタリング。立派なお堀や復元された石垣を巡る。',
                photo: '歴史情緒あふれる城郭建築の撮影スポット。'
            },
            {
                id: 'gotenzeki',
                title: '七日町御殿堰 ＆ S-PAL山形',
                category: 'day2',
                day: [2],
                lat: 38.2520,
                lng: 140.3385,
                icon: 'fa-store',
                time: '2日目 15:00 - 15:45',
                desc: '400年前の水路を活かした和モダン空間。駅直結のS-PAL山形で限定お土産を購入し部屋へ。',
                photo: '水路の涼やかな水音を聞きながらカフェ休憩もおすすめ。'
            }
        ];

        // 地図の初期化（山形市中心部を表示）
        const map = L.map('map').setView([38.2800, 140.3600], 11);

        // OpenStreetMap タイルレイヤー
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 18
        }).addTo(map);

        // マーカーとレイヤーの管理
        const markers = {};
        const layerDay1 = L.layerGroup().addTo(map);
        const layerDay2 = L.layerGroup().addTo(map);

        // ルート（ポリライン）データ
        const routeDay1Coords = [
            [38.4119, 140.3712], // 空港
            [38.2480, 140.3275], // 山形駅/ホテル
            [38.3120, 140.4367], // 山寺
            [38.2492, 140.3298], // 麺藤田
            [38.2325, 140.3150], // テルメ
            [38.2480, 140.3275]  // ホテル
        ];

        const routeDay2Coords = [
            [38.2480, 140.3275], // ホテル
            [38.1632, 140.4030], // 蔵王温泉
            [38.1331, 140.4439], // 蔵王地蔵山頂
            [38.2480, 140.3275], // ホテル
            [38.2530, 140.3278], // 霞城公園
            [38.2520, 140.3385], // 御殿堰
            [38.2480, 140.3275], // ホテル（16:50 C/O）
            [38.4119, 140.3712]  // 空港
        ];

        const polyline1 = L.polyline(routeDay1Coords, { color: '#0284c7', weight: 4, opacity: 0.7, dashArray: '6, 8' }).addTo(layerDay1);
        const polyline2 = L.polyline(routeDay2Coords, { color: '#059669', weight: 4, opacity: 0.7, dashArray: '6, 8' }).addTo(layerDay2);

        // スポットマーカー描画 ＆ サイドバー生成
        const spotListEl = document.getElementById('spot-list');

        spots.forEach(spot => {
            // ピンのクラス判定
            let pinClass = 'pin-hub';
            if (spot.category === 'day1') pinClass = 'pin-day1';
            if (spot.category === 'day2') pinClass = 'pin-day2';
            if (spot.category === 'food') pinClass = 'pin-food';

            // アイコン作成
            const customIcon = L.divIcon({
                className: '',
                html: `<div class="custom-pin ${pinClass}"><i class="fa-solid ${spot.icon}"></i></div>`,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });

            // マーカー生成
            const marker = L.marker([spot.lat, spot.lng], { icon: customIcon });

            // ポップアップコンテンツ
            const popupHtml = `
                <div class="space-y-1.5 text-xs">
                    <div class="font-bold text-sm text-slate-800 border-b pb-1">${spot.title}</div>
                    <div class="text-sky-700 font-bold"><i class="fa-regular fa-clock mr-1"></i>${spot.time}</div>
                    <p class="text-slate-600">${spot.desc}</p>
                    <div class="p-2 bg-amber-50 rounded border border-amber-200 text-amber-900 font-medium text-[11px]">
                        ${spot.photo}
                    </div>
                </div>
            `;
            marker.bindPopup(popupHtml);

            // レイヤー追加
            if (spot.day.includes(1)) marker.addTo(layerDay1);
            if (spot.day.includes(2) && !spot.day.includes(1)) marker.addTo(layerDay2);

            markers[spot.id] = marker;

            // サイドバー要素生成
            const card = document.createElement('div');
            card.className = 'p-3 bg-slate-50 hover:bg-sky-50 rounded-xl border border-slate-200 cursor-pointer transition-all hover:shadow-md';
            card.onclick = () => focusSpot(spot.id);
            card.innerHTML = `
                <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-slate-800 text-xs flex items-center gap-1.5">
                        <i class="fa-solid ${spot.icon} text-slate-600"></i> ${spot.title}
                    </span>
                </div>
                <div class="text-[11px] text-sky-700 font-bold mb-1">${spot.time}</div>
                <div class="text-[11px] text-slate-600 line-clamp-2">${spot.desc}</div>
            `;
            spotListEl.appendChild(card);
        });

        // スポットフォーカス処理
        function focusSpot(id) {
            const spot = spots.find(s => s.id === id);
            if (spot) {
                map.flyTo([spot.lat, spot.lng], 14, { duration: 1.2 });
                markers[id].openPopup();
            }
        }

        // フィルター切替処理
        function filterRoute(type) {
            // ボタンの見た目初期化
            ['all', 'day1', 'day2'].forEach(b => {
                const btn = document.getElementById('btn-' + b);
                btn.className = 'px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700';
            });

            const activeBtn = document.getElementById('btn-' + type);
            activeBtn.className = 'px-2.5 py-1.5 rounded-lg bg-sky-500 text-white shadow';

            // レイヤーの表示・非表示
            if (type === 'all') {
                map.addLayer(layerDay1);
                map.addLayer(layerDay2);
                map.setView([38.2800, 140.3600], 11);
            } else if (type === 'day1') {
                map.addLayer(layerDay1);
                map.removeLayer(layerDay2);
                map.fitBounds(polyline1.getBounds(), { padding: [30, 30] });
            } else if (type === 'day2') {
                map.removeLayer(layerDay1);
                map.addLayer(layerDay2);
                map.fitBounds(polyline2.getBounds(), { padding: [30, 30] });
            }
        }
    </script>
</body>
</html>

